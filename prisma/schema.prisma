generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  avatarUrl   String?
  userType    UserType   @default(SCHOOL)
  institution String?
  timezone    String     @default("UTC")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  examDates   ExamDate[]
  schedules   Schedule[]
  subjects    Subject[]

  @@map("users")
}

model Subject {
  id               String            @id @default(cuid())
  name             String
  color            String            @default("#3b82f6")
  completionPct    Int               @default(0)
  icon             String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           String
  examDates        ExamDate[]
  scheduleSessions ScheduleSession[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics           Topic[]

  @@map("subjects")
}

model Topic {
  id               String            @id @default(cuid())
  name             String
  description      String?
  completionPct    Int               @default(0)
  orderIndex       Int               @default(0)
  isCompleted      Boolean           @default(false)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subjectId        String
  scheduleSessions ScheduleSession[]
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model ExamDate {
  id          String   @id @default(cuid())
  title       String
  examDate    DateTime
  location    String?
  duration    Int?
  notes       String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_dates")
}

model Schedule {
  id            String            @id @default(cuid())
  name          String            @default("My Study Plan")
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean           @default(true)
  generatedByAI Boolean           @default(true)
  aiModel       String?           @default("gemini-2.0-flash")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String
  sessions      ScheduleSession[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model ScheduleSession {
  id              String      @id @default(cuid())
  date            DateTime
  startTime       String
  durationMinutes Int
  sessionType     SessionType @default(NEW_MATERIAL)
  isCompleted     Boolean     @default(false)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  scheduleId      String
  subjectId       String
  topicId         String?
  schedule        Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic           Topic?      @relation(fields: [topicId], references: [id])

  @@map("schedule_sessions")
}

enum UserType {
  SCHOOL
  UNIVERSITY
}

enum SessionType {
  NEW_MATERIAL
  REVIEW
  EXAM_PREP
  PRACTICE
}
